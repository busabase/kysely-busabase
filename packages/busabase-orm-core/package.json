{
  "name": "busabase-orm-core",
  "version": "0.2.0",
  "description": "Shared Busabase query engine for ORM drivers — Base resolution, SQL value semantics, push-down decisions and paging. NOT published to npm: it is bundled into drizzle-busabase and kysely-busabase at build time, so neither has a workspace dependency to install.",
  "license": "MIT",
  "homepage": "https://github.com/busabase/kysely-busabase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/busabase/kysely-busabase.git"
  },
  "bugs": "https://github.com/busabase/kysely-busabase/issues",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint:err && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts'",
    "lint": "biome format . --write && biome check .",
    "lint:err": "biome format . --write && biome check . --write --diagnostic-level=error"
  },
  "dependencies": {
    "busabase-sdk": "^0.60.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Busabase",
    "email": "support@busabase.com"
  }
}
